{
  "name": "enheng-tweet-card-generator",
  "version": "0.1.0",
  "private": true,
  "description": "恩亨公开推文卡片与抖音图文生成器预览版",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:build": "node scripts/build-generated-backgrounds.mjs",
    "content:import": "node scripts/import-enheng-evidence.mjs",
    "tweets:sync": "node scripts/sync-opentwitter.mjs",
    "build": "npm run assets:build && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "html-to-image": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "caniuse-lite": "^1.0.30001809",
    "node-releases": "^2.0.53"
  }
}
